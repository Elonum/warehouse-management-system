# Copy to backend/.env when running API from backend/ (see README).
# Never commit real values — .env is gitignored.

# --- Server ---
PORT=8080
ENV=development
BASE_URL=http://localhost:8080

# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=warehouse

# --- Auth ---
# Required in production (ENV=production). Generate a long random string.
JWT_SECRET=

# --- Frontend (CORS, password reset links) ---
FRONTEND_URL=http://localhost:5173
# ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Email / SMTP (required for password reset in production) ---
# SMTP_TLS_MODE: starttls (587), tls (465), none (development-only)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=Warehouse Management System
SMTP_TLS_MODE=starttls
SMTP_TIMEOUT=10s

# --- Wildberries (optional) ---
# Statistics API — остатки на МП (категория «Статистика» в токене)
WB_STATISTICS_TOKEN=
# WB_STATISTICS_BASE_URL=https://statistics-api.wildberries.ru
# WB personal token limits (Statistics API): burst 10/min, sustained ~1/min
# WB_UPSTREAM_BURST=10
# WB_UPSTREAM_REFILL_INTERVAL=1m
# WB_UPSTREAM_MIN_INTERVAL=6s

# --- Ozon Seller API (optional) ---
OZON_CLIENT_ID=
OZON_API_KEY=
# OZON_BASE_URL=https://api-seller.ozon.ru
# OZON_UPSTREAM_BURST=5
# OZON_UPSTREAM_REFILL_INTERVAL=2s
# OZON_UPSTREAM_MIN_INTERVAL=350ms

# --- Marketplace upstream guards ---
# INTEGRATION_STOCKS_CACHE_TTL=90s
# INTEGRATION_UPSTREAM_MAX_RETRIES=3
# INTEGRATION_UPSTREAM_RETRY_BASE=1s
# INTEGRATION_UPSTREAM_RETRY_MAX=30s

# --- Frontend (Vite, optional) ---
# Create frontend/.env.local if API is not on localhost:8080
# VITE_API_URL=http://localhost:8080/api/v1
